{
  "name": "mystarquest-functions",
  "private": true,
  "scripts": {
    "build": "tsc",
    "migrate:split-chores-tests": "node scripts/migrate-separate-chores-tests.ts",
    "migrate:split-chores-tests:finalize": "node scripts/migrate-separate-chores-tests.ts --write --delete-legacy",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "node-ical": "^0.27.2"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.5": true
  }
}
