rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function childPath(uid, childId) { return /databases/$(database)/documents/users/$(uid)/children/$(childId); }
    function member(uid, childId) {
      return signedIn() && exists(childPath(uid, childId)) &&
        (owner(uid) ||
          (exists(/databases/$(database)/documents/users/$(uid)/children/$(childId)/parents/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/users/$(uid)/children/$(childId)/parents/$(request.auth.uid)).data.status == 'active'));
    }
    function unlocked(uid) {
      return !exists(/databases/$(database)/documents/users/$(uid)) ||
        get(/databases/$(database)/documents/users/$(uid)).data.get('sharingMigrationChild', null) == null;
    }
    function legacy(uid, childId) {
      return owner(uid) && unlocked(uid) && exists(childPath(uid, childId)) &&
        get(childPath(uid, childId)).data.get('sharedDataVersion', 0) == 0 &&
        get(childPath(uid, childId)).data.get('sharingMigration', null) == null;
    }
    match /users/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid) && !request.resource.data.keys().hasAny(['sharingMigrationChild']);
      allow update: if owner(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sharingMigrationChild']);
      allow delete: if false;
      match /childAccess/{key} { allow read: if owner(uid); allow write: if false; }
      match /children/{childId} {
        allow get: if owner(uid) || member(uid, childId);
        allow list: if owner(uid);
        allow create: if owner(uid) && unlocked(uid) && !request.resource.data.keys().hasAny(['sharedDataVersion','sharingMigration','sharingMigrationLeaseUntil','sharedAt']);
        allow update: if legacy(uid, childId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sharedDataVersion','sharingMigration','sharingMigrationLeaseUntil','sharedAt']);
        allow delete: if legacy(uid, childId);
        match /parents/{parentUid} {
          allow get: if exists(childPath(uid, childId)) && (owner(uid) || (signedIn() && request.auth.uid == parentUid));
          allow list: if owner(uid) && exists(childPath(uid, childId));
          allow write: if false;
        }
        match /rewards/{rewardId} { allow read: if member(uid, childId); allow write: if false; }
        match /activityProgress/{progressId} { allow read: if member(uid, childId); allow write: if false; }
        match /starEvents/{eventId} { allow read: if member(uid, childId); allow write: if false; }
        match /redemptions/{eventId} { allow read: if member(uid, childId); allow write: if false; }
        match /operationReceipts/{receiptId} { allow read, write: if false; }
        match /deletedActivities/{key} { allow read, write: if false; }
      }
      match /{kind}/{entityId} {
        allow read: if kind in ['chores','tests','choreTodos'] && (owner(uid) || member(uid, resource.data.childId));
        allow create: if kind in ['chores','tests','choreTodos'] && legacy(uid, request.resource.data.childId);
        allow update: if kind in ['chores','tests','choreTodos'] && legacy(uid, resource.data.childId) && request.resource.data.childId == resource.data.childId;
        allow delete: if kind in ['chores','tests','choreTodos'] && legacy(uid, resource.data.childId);
      }
      match /rewards/{rewardId} { allow read: if owner(uid); allow write: if owner(uid) && unlocked(uid); }
      match /starEvents/{eventId} {
        allow read: if owner(uid);
        allow create: if legacy(uid, request.resource.data.childId);
        allow update, delete: if false;
      }
      match /redemptions/{eventId} {
        allow read: if owner(uid);
        allow create: if legacy(uid, request.resource.data.childId);
        allow update, delete: if false;
      }
      match /deviceActivities/{activityId} {
        allow read: if owner(uid);
        allow create: if legacy(uid, request.resource.data.childId);
        allow update: if legacy(uid, resource.data.childId) && request.resource.data.childId == resource.data.childId;
        allow delete: if legacy(uid, resource.data.childId);
      }
      match /syncReceipts/{operationId} {
        allow read: if owner(uid);
        allow create: if owner(uid) && unlocked(uid) && (request.resource.data.result.collection != 'children' || !existsAfter(childPath(uid, request.resource.data.result.entityId)) || getAfter(childPath(uid, request.resource.data.result.entityId)).data.get('sharedDataVersion', 0) == 0);
      }
    }
    match /childInvitations/{id} { allow read, write: if false; }
    match /mailOutbox/{id} { allow read, write: if false; }
    match /invitationRates/{id} { allow read, write: if false; }
  }
}
